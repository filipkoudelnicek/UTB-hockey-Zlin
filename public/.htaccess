<IfModule mod_rewrite.c>

    <IfModule mod_negotiation.c>
        Options -Indexes
    </IfModule>

    RewriteEngine On


    # ----------------------------------------------------------
    # Kanonická URL - odstranit interní WEDOS cestu
    #
    # /domains/utbhockey.cz/public/admin-utb
    # -> /admin-utb
    # ----------------------------------------------------------
    RewriteCond %{THE_REQUEST} \s/+domains/utbhockey\.cz/public(?:/([^\s?]*))?(?:[?\s]) [NC]
    RewriteRule ^ https://utbhockey.cz/%1 [R=301,L,NE]


    # ----------------------------------------------------------
    # Kanonická URL - odstranit /public
    #
    # /public/admin-utb
    # -> /admin-utb
    # ----------------------------------------------------------
    RewriteCond %{THE_REQUEST} \s/+public(?:/([^\s?]*))?(?:[?\s]) [NC]
    RewriteRule ^ https://utbhockey.cz/%1 [R=301,L,NE]


    # ----------------------------------------------------------
    # Security headers
    # ----------------------------------------------------------
    <IfModule mod_headers.c>
        Header always set Strict-Transport-Security "max-age=31536000"
        Header always set X-Content-Type-Options "nosniff"
        Header always set Referrer-Policy "strict-origin-when-cross-origin"
    </IfModule>


    # ----------------------------------------------------------
    # Static asset cache
    # ----------------------------------------------------------
    <IfModule mod_headers.c>
        <FilesMatch "\.woff2$">
            Header always set Cache-Control "public, max-age=31536000, immutable"
        </FilesMatch>

        <FilesMatch "\.(?:css|js)$">
            Header always set Cache-Control "public, max-age=31536000"
        </FilesMatch>

        <FilesMatch "\.(?:avif|gif|ico|jpe?g|png|svg|webp)$">
            Header always set Cache-Control "public, max-age=31536000"
        </FilesMatch>
    </IfModule>


    # ----------------------------------------------------------
    # /index.php a /index.html -> /
    # ----------------------------------------------------------
    RewriteCond %{THE_REQUEST} \s/+index\.(?:php|html)(?:[\s?]) [NC]
    RewriteRule ^index\.(?:php|html)$ / [R=301,L]


    # ----------------------------------------------------------
    # Odstranit trailing slash
    # Výjimka pro skutečné adresáře a /api/
    # ----------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/api(?:/|$) [NC]
    RewriteCond %{REQUEST_URI} ^(.+)/$
    RewriteRule ^ %1 [R=301,L]


    # ----------------------------------------------------------
    # Authorization header
    # ----------------------------------------------------------
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]


    # ----------------------------------------------------------
    # X-XSRF-Token header
    # ----------------------------------------------------------
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]


    # ----------------------------------------------------------
    # Laravel front controller
    # ----------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]

</IfModule>